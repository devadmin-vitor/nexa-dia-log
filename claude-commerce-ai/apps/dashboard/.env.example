# O scripts/setup.ps1 gera apps/dashboard/.env.local automaticamente a partir do .env da raiz.
# Somente servidor: NUNCA use o prefixo NEXT_PUBLIC_ para estes valores.
BACKEND_URL=http://127.0.0.1:8000
BACKEND_API_TOKEN=

# Basic Auth opcional do dashboard (recomendado se o computador for compartilhado)
DASHBOARD_USER=
DASHBOARD_PASSWORD=
