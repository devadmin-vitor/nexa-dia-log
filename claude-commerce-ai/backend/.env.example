# ---- Ambiente
APP_ENV=development            # development | production
CORS_ORIGINS=http://localhost:3000

# ---- Autenticação servidor-a-servidor (gere com: python -c "import secrets;print(secrets.token_urlsafe(48))")
BACKEND_API_TOKEN=             # usado SOMENTE pelo servidor Next.js
SCHEDULER_TOKEN=               # usado SOMENTE pelo n8n (header X-Scheduler-Token)

# ---- Claude API
ANTHROPIC_API_KEY=             # vazio => agentes em modo simulado
AI_MODE=auto                   # auto | live | simulated
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium           # low | medium | high | xhigh | max
CLAUDE_USE_FALLBACKS=true      # fallback no servidor em caso de recusa por política
DAILY_AI_BUDGET_USD=5
PER_RUN_MAX_TOKENS=8000

# ---- Supabase (Fase 2 — ainda não utilizado pelo backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- TikTok Shop (somente após aprovação no Partner Center — conector ainda não implementado)
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=

# ---- Operação
KILL_SWITCH=0                  # 1 => inicia com tudo bloqueado
SEED_SIMULATED_DATA=true       # carrega dados de demonstração (marcados como simulados)
