{
  "name": "Claude Commerce AI — Fábrica de conteúdo",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "content_factory-schedule",
      "name": "Agendamento",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "content_factory-manual",
      "name": "Executar manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/v1/scheduler/trigger/content_factory",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "id": "content_factory-trigger",
      "name": "Disparar no backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Claude Commerce Scheduler"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Roteiros/vídeos dos produtos aprovados (09:00). O backend aplica parada de emergência, limites e idempotência."
    }
  ],
  "connections": {
    "Agendamento": {
      "main": [
        [
          {
            "node": "Disparar no backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Executar manualmente": {
      "main": [
        [
          {
            "node": "Disparar no backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "America/Sao_Paulo",
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}