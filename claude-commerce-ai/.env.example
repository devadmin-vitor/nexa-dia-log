# Claude Commerce AI — variáveis de ambiente (copie para .env; NUNCA versione o .env)
# scripts/setup.ps1 cria o .env e gera os tokens/senhas locais automaticamente.
# Comentários sempre em linha própria (comentário na mesma linha vira parte do valor).

PROJECT_NAME=Claude Commerce AI
BRAND_NAME=BRAND_NAME
APP_ENV=development

# ---- Autenticação interna (gerados pelo setup.ps1)
# Token usado SOMENTE pelo servidor do dashboard (Next.js) para chamar a API
BACKEND_API_TOKEN=
# Token usado SOMENTE pelo n8n (header X-Scheduler-Token)
SCHEDULER_TOKEN=
CORS_ORIGINS=http://localhost:3000

# ---- Claude API
ANTHROPIC_API_KEY=
# Modelo configurável; confira a lista oficial de modelos ativos da Anthropic
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=8000
CLAUDE_USE_FALLBACKS=true

# ---- Orçamento (BRL). A API cobra em USD: informe a cotação para o controle funcionar.
MONTHLY_BUDGET_BRL=150
DAILY_API_BUDGET_BRL=4
# Cotação USD→BRL usada no controle de custos (ex.: 5.40). Vazio = chamadas pagas bloqueadas.
USD_BRL_RATE=

# ---- Supabase local (valores exibidos por: npx supabase status)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- Redis (docker-compose). Senha gerada pelo setup.ps1; REDIS_URL deve usar a mesma senha e porta.
# Se a porta 6379 já estiver ocupada por outro programa, troque REDIS_HOST_PORT (ex.: 6380)
# e use a mesma porta em REDIS_URL.
REDIS_HOST_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# ---- n8n (docker-compose)
# O login é a conta "owner" criada no primeiro acesso a http://localhost:5678
# (o n8n atual não usa N8N_USER/N8N_PASSWORD por variável de ambiente).
# Se a porta 5678 estiver ocupada, troque N8N_HOST_PORT e use a mesma porta em N8N_URL.
N8N_HOST_PORT=5678
N8N_URL=http://127.0.0.1:5678
# Gerado pelo setup.ps1; não altere depois de criar credenciais no n8n.
N8N_ENCRYPTION_KEY=
N8N_VERSION=2.48.8

# ---- TikTok Shop (somente após aprovação no Partner Center; conector ainda não implementado)
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=

# ---- Emergência: true bloqueia agentes, tarefas, agendamentos e aprovações desde a inicialização
EMERGENCY_STOP=false
